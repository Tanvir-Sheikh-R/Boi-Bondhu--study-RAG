# ========================================================
# Study-RAG (বই বন্ধু) - Backend API Dockerfile
# ========================================================
FROM python:3.12-slim

# Prevent Python from writing .pyc and ensure stdout/stderr are flushed immediately
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    HOST=0.0.0.0 \
    PORT=8000

# Install system dependencies:
# - tesseract-ocr: required for OCR fallback
# - poppler-utils: required for pdf rendering/processing
# - libgl1 & libglib2.0-0: required for OpenCV and graphics libraries
# - curl: required for container healthcheck
# - build-essential: required for compiling native wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency requirements first to leverage Docker layer caching
COPY requirements.txt .

# Install dependencies (CPU/CUDA torch compatible)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Create runtime directories for data persistence and caches
RUN mkdir -p /app/backend/data/threads \
             /app/embedding_cache \
             /app/ocr_cache \
             /app/model_cache

# Copy application artifacts and code
COPY chapters.json ./
COPY backend/ ./backend/
COPY README.md ./

# Expose API port
EXPOSE 8000

# Health check to ensure API is ready (startup loads multilingual-e5-large in ~20s)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start the API server
CMD ["python", "-m", "backend.run"]
